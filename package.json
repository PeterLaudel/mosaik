{
  "name": "mosaik",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @mosaik/contract && concurrently -k -n contract,api,web -c gray,blue,magenta \"npm run dev -w @mosaik/contract\" \"npm run dev -w @mosaik/api\" \"npm run dev -w @mosaik/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently -k -n api,web -c blue,magenta \"npm run start -w @mosaik/api\" \"npm run start -w @mosaik/web\"",
    "worker": "npm run worker -w @mosaik/api",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @mosaik/api",
    "test:sqlite": "npm run test:sqlite -w @mosaik/api",
    "test:postgres": "npm run test:postgres -w @mosaik/api",
    "test:ci": "npm run test && npm run lint && npm run typecheck",
    "ci": "npm run build -w @mosaik/contract && npm run typecheck && npm run lint && npm run test",
    "db:create": "npm run db:create -w @mosaik/api",
    "db:drop": "npm run db:drop -w @mosaik/api",
    "db:migrate": "npm run db:migrate -w @mosaik/api",
    "db:seed": "npm run db:seed -w @mosaik/api",
    "e2e": "npm run e2e -w @mosaik/web",
    "e2e:ui": "npm run e2e:ui -w @mosaik/web"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@yao-pkg/pkg": "^6.16.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "globals": "^17.5.0",
    "typescript": "^6",
    "typescript-eslint": "^8.58.2"
  }
}
