{
  "name": "mosaik",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "worker": "tsx src/worker.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --ignore-pattern=.gitignore --max-warnings=0 .",
    "typecheck": "tsc --incremental false",
    "test": "jest --runInBand",
    "test:sqlite": "DATABASE_DIALECT=sqlite jest --runInBand",
    "test:postgres": "DATABASE_DIALECT=postgres jest --runInBand",
    "test:ci": "npm run test && npm run lint && npm run typecheck",
    "ci": "npm run typecheck && npm run lint && npm run test",
    "db:create": "tsx ./tasks/dbCreate.ts",
    "db:drop": "tsx ./tasks/dbDrop.ts",
    "db:migrate": "kysely migrate:latest --debug",
    "db:seed": "kysely seed run --debug --experimental-resolve-tsconfig-paths",
    "kysely": "kysely",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "api": "tsup --config tsup.api.config.ts --watch --onSuccess \"node --enable-source-maps dist/api/main.mjs\"",
    "contract:build": "npm run build --workspace @peterlaudel/mosaik-contract",
    "api:build": "tsup --config tsup.api.config.ts",
    "api:start": "node --enable-source-maps dist/api/main.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@libpdf/core": "^0.2.4",
    "@material-tailwind/react": "^2.1.10",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.2",
    "@mui/x-date-pickers": "^9.0.2",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@orpc/client": "2.0.0-beta.49",
    "@orpc/contract": "2.0.0-beta.49",
    "@orpc/nest": "2.0.0-beta.49",
    "@orpc/openapi": "2.0.0-beta.49",
    "@orpc/server": "2.0.0-beta.49",
    "@tanstack/react-query": "^5.99.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "better-auth": "1.7.18",
    "better-sqlite3": "^12.9.0",
    "blob-stream": "^0.1.3",
    "dayjs": "^1.11.20",
    "google-auth-library": "^10.6.2",
    "kysely": "^0.28.19",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.75.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "schema-dts": "^2.0.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/testing": "^12.4.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/blob-stream": "^0.1.33",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@yao-pkg/pkg": "^6.16.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "fishery": "^2.4.0",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "kysely-ctl": "^0.20.0",
    "postcss": "^8",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.2.2",
    "timekeeper": "^2.3.1",
    "ts-jest": "^29.4.9",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "typescript-eslint": "^8.58.2",
    "xslt3": "^2.7.0"
  }
}
