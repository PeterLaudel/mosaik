{
  "name": "mosaik",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "worker": "tsx src/worker.ts",
    "lint": "eslint --ignore-pattern=.gitignore --max-warnings=0 .",
    "typecheck": "tsc --incremental false",
    "test": "jest --runInBand",
    "test:sqlite": "DATABASE_DIALECT=sqlite jest --runInBand",
    "test:postgres": "DATABASE_DIALECT=postgres jest --runInBand",
    "test:ci": "npm run test && npm run lint && npm run typecheck",
    "ci": "npm run typecheck && npm run lint && npm run test",
    "db:create": "tsx ./tasks/dbCreate.ts",
    "db:drop": "tsx ./tasks/dbDrop.ts",
    "db:migrate": "kysely migrate:latest --debug",
    "db:seed": "kysely seed run --debug --experimental-resolve-tsconfig-paths",
    "kysely": "kysely",
    "api": "tsup --config tsup.api.config.ts --watch --onSuccess \"node --enable-source-maps dist/api/main.mjs\"",
    "contract:build": "npm run build --workspace @peterlaudel/mosaik-contract",
    "api:build": "tsup --config tsup.api.config.ts",
    "api:start": "node --enable-source-maps dist/api/main.mjs"
  },
  "dependencies": {
    "@libpdf/core": "^0.2.4",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@orpc/client": "2.0.0-beta.49",
    "@orpc/contract": "2.0.0-beta.49",
    "@orpc/nest": "2.0.0-beta.49",
    "@orpc/openapi": "2.0.0-beta.49",
    "@orpc/server": "2.0.0-beta.49",
    "better-auth": "1.7.18",
    "better-sqlite3": "^12.9.0",
    "blob-stream": "^0.1.3",
    "dayjs": "^1.11.20",
    "kysely": "^0.28.19",
    "nodemailer": "^7.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^7.6.13",
    "@types/blob-stream": "^0.1.33",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "fishery": "^2.4.0",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "kysely-ctl": "^0.20.0",
    "supertest": "^7.3.2",
    "timekeeper": "^2.3.1",
    "ts-jest": "^29.4.9",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "typescript-eslint": "^8.58.2",
    "xslt3": "^2.7.0"
  }
}
