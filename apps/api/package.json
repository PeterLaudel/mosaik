{
  "name": "@mosaik/api",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=${NODE_ENV:-development} nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "NODE_ENV=${NODE_ENV:-production} node dist/src/main.js",
    "worker": "NODE_ENV=${NODE_ENV:-development} tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:sqlite": "DATABASE_DIALECT=sqlite jest --runInBand",
    "test:postgres": "DATABASE_DIALECT=postgres jest --runInBand",
    "db:create": "NODE_ENV=${NODE_ENV:-development} tsx ./tasks/dbCreate.ts",
    "db:drop": "NODE_ENV=${NODE_ENV:-development} tsx ./tasks/dbDrop.ts",
    "db:migrate": "NODE_ENV=${NODE_ENV:-development} kysely migrate:latest --debug",
    "db:seed": "NODE_ENV=${NODE_ENV:-development} kysely seed run --debug",
    "kysely": "kysely"
  },
  "dependencies": {
    "@libpdf/core": "^0.2.4",
    "@mosaik/contract": "*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@orpc/nest": "^1.16.2",
    "@orpc/server": "^1.16.2",
    "better-sqlite3": "^12.9.0",
    "blob-stream": "^0.1.3",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.15",
    "kysely": "^0.28.16",
    "nodemailer": "^7.0.7",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^7.6.13",
    "@types/blob-stream": "^0.1.33",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "fishery": "^2.4.0",
    "jest": "^30.3.0",
    "kysely-ctl": "^0.20.0",
    "supertest": "^7.3.2",
    "timekeeper": "^2.3.1",
    "tsx": "^4.21.0",
    "xslt3": "^2.7.0"
  }
}
